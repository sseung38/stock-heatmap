{
  "name": "stock-heatmap",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,green \"npm run api:local\" \"npm run dev -w web\"",
    "dev:remote": "jq -r '.StockHeatmapStack.WebConfig' cdk-outputs.json > web/config.remote.json && concurrently -n api,web -c blue,green \"cd backend && ./gradlew :local:bootRun --args=--heatmap.config-file=web/config.remote.json\" \"npm run dev -w web\"",
    "api:local": "cd backend && ./gradlew :local:bootRun",
    "refresh": "cd backend && ./gradlew :local:bootRun --args=\"--spring.main.web-application-type=none --refresh=${JOB:-all}\"",
    "smoke": "cd backend && ./gradlew :local:bootRun --args=\"--spring.main.web-application-type=none --smoke\"",
    "build:backend": "cd backend && ./gradlew build :functions:lambdaZip"
  },
  "workspaces": [
    "shared",
    "web",
    "infra"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
